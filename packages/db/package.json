{
  "name": "@syncnotes/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations and client shared by the API and the collaboration server",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:test": "dotenv -e ../../.env.test -- prisma migrate deploy",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^10.0.0",
    "prisma": "^7.10.1"
  }
}
