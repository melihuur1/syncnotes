# ---------------------------------------------------------------------------
# SyncNotes — local development configuration.
# Copy to `.env` (cp .env.example .env). Never commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=test

# Infrastructure (matches docker-compose.yml)
DATABASE_URL=postgresql://syncnotes:syncnotes@localhost:5433/syncnotes_test
REDIS_URL=redis://localhost:6380

# Public origin of the web app (CORS + cookie scope)
WEB_ORIGIN=http://localhost:5173

# REST API
API_PORT=4000
# Access-token JWT (cookie `sn_access`). Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=test-only-access-secret-0123456789abcdef0123
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# `true` behind HTTPS (sets the Secure attribute on cookies)
COOKIE_SECURE=false

# Collaboration tickets (API signs, collab server verifies). Must differ from JWT_ACCESS_SECRET.
COLLAB_TICKET_SECRET=test-only-collab-secret-0123456789abcdef0123
COLLAB_TICKET_TTL_SECONDS=60

# Collaboration server
COLLAB_PORT=1234
# How long a cached role is trusted before being re-read from Postgres (fallback when Redis events are lost)
PERMISSION_CACHE_TTL_MS=5000
# Debounce for persisting Yjs state
STORE_DEBOUNCE_MS=2000
STORE_MAX_DEBOUNCE_MS=10000
# Minimum minutes between automatic history snapshots
AUTO_VERSION_INTERVAL_MINUTES=10

# Tests: relax the per-IP auth throttle (lockout is tested separately)
THROTTLE_AUTH_LIMIT=1000
THROTTLE_DEFAULT_LIMIT=5000
