{
  "name": "@syncnotes/collab",
  "version": "0.1.0",
  "private": true,
  "description": "SyncNotes collaboration server — Hocuspocus/Yjs WebSocket sync, authorization and persistence",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src"
  },
  "dependencies": {
    "@hocuspocus/extension-redis": "^4.8.0",
    "@hocuspocus/server": "^4.8.0",
    "@syncnotes/db": "*",
    "@syncnotes/shared": "*",
    "ioredis": "~5.6.1",
    "jsonwebtoken": "^9.0.2",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.33",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^4.8.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.2.3",
    "tsx": "^4.20.6",
    "vitest": "^5.1.0",
    "ws": "^8.18.3"
  }
}
